{#- ============================================================
    THE master template. One template every page uses.
    A page supplies front-matter (hero + an ordered list of
    `blocks`), and this renders them all in the unified .story
    frame. Change this file -> every page using it changes.

    ARCHITECTURE -- proper full-page scroller:
      <nav>            position:fixed, floats OVER everything.
      <div .story-scroll>   the ONE scroll container. It owns the
                       scrollbar and the snap (height:100svh,
                       overflow-y:scroll, scroll-snap-type). Because
                       snap lives here -- not on <html> -- the fixed
                       nav can never be captured by it (the Firefox
                       sticky-in-snap bug is structurally impossible).
        <section .story>    each panel is exactly 100svh, snap-align
                       start, content flex-centred. No nav-offset
                       maths: the nav floats, panels are full-height.
        <div .story-tail>   trailing non-snap region (SEO prose +
                       footer). Scrolls normally after the panels.

    Front-matter contract:
      hero: { eyebrow?, heading, lede?, actions?[{label,href,style}], video? }
      blocks: [ ordered list, each { type: ..., feature?, ...fields } ]
        feature: true -> paint this ONE block as the gradient brand band
                         (white text). Use at most once per page.
        types:
          - prose:   { eyebrow?, heading?, text|html, alt? }
          - split:   { eyebrow?, heading, text, reverse?, alt? }
          - steps:   { eyebrow?, heading, items:[{title,text}], video?, alt? }
          - cards:   { eyebrow?, heading, items:[{kicker,title,text,href}], alt? }
          - tags:    { eyebrow?, heading, text?, items:[{label,href,strong?}], alt? }
          - raw:     { html, alt? }   (escape hatch for bespoke content)
      (footerCta in front-matter renders the closing CTA as today.)
      Free-form page body (the {{ content }}) renders inside .story-tail.
   ============================================================ -#}
<!DOCTYPE html>
<html lang="{{ seo.lang or 'en' }}">
{% include "partials/head.njk" %}
<body class="{{ bodyClass or 'page-story' }}">
{% include "partials/nav.njk" %}
<main class="story-scroll">

{%- if hero %}
<section id="top" class="story story-hero">
    <div class="story-inner">
        {%- if hero.eyebrow %}<p class="story-eyebrow">{{ hero.eyebrow }}</p>{% endif %}
        <h1 class="story-h1">{{ hero.heading | safe }}</h1>
        {%- if hero.lede %}<p class="story-lede">{{ hero.lede | safe }}</p>{% endif %}
        {%- if hero.actions %}
        <div class="story-actions">
            {%- for a in hero.actions %}
            <a href="{{ a.href }}" class="btn {{ a.style or 'btn-primary' }}">{{ a.label }}</a>
            {%- endfor %}
        </div>
        {%- endif %}
    </div>
    {%- if hero.video %}
    <div class="story-media-hero story-video-embed">
        <iframe src="https://www.youtube-nocookie.com/embed/{{ hero.video }}?rel=0" title="Quickler walkthrough" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
    {%- endif %}
</section>
{%- endif %}

{#- Alternating colour rhythm so each reel panel is visually distinct and
    "instagrammable" on its own: hero is white (index 0), then panels
    alternate gradient / white / gradient / white down the page. A block can
    still force its look with feature:true (gradient), alt:true (tinted) or
    plain:true (white). The auto-rhythm uses loop.index (1-based): odd ->
    gradient band, even -> white. -#}
{%- for b in blocks %}
{%- if b.feature %}{% set altcls = "story-feature" %}
{%- elif b.plain %}{% set altcls = "" %}
{%- elif b.alt %}{% set altcls = "story-alt" %}
{%- elif loop.index is odd %}{% set altcls = "story-feature" %}
{%- else %}{% set altcls = "" %}{% endif %}
{%- if b.type == "prose" %}
<section class="story {{ altcls }} reveal-on-scroll">
    <div class="story-inner">
        {%- if b.eyebrow %}<p class="story-eyebrow">{{ b.eyebrow }}</p>{% endif %}
        {%- if b.heading %}<h2 class="story-h2">{{ b.heading | safe }}</h2>{% endif %}
        {%- if b.html %}{{ b.html | safe }}{% else %}<p class="story-text story-text-centre">{{ b.text | safe }}</p>{% endif %}
    </div>
</section>
{%- elif b.type == "split" %}
<section class="story {{ altcls }} reveal-on-scroll">
    <div class="story-split {{ 'story-split-reverse' if b.reverse }}">
        <div class="story-copy">
            {%- if b.eyebrow %}<p class="story-eyebrow">{{ b.eyebrow }}</p>{% endif %}
            <h2 class="story-h2">{{ b.heading | safe }}</h2>
            <p class="story-text">{{ b.text | safe }}</p>
        </div>
        <div class="story-media" role="img" aria-label="{{ b.mediaAlt or '' }}"></div>
    </div>
</section>
{%- elif b.type == "steps" %}
<section class="story {{ altcls }} reveal-on-scroll">
    <div class="story-inner">
        {%- if b.eyebrow %}<p class="story-eyebrow">{{ b.eyebrow }}</p>{% endif %}
        <h2 class="story-h2">{{ b.heading | safe }}</h2>
        <ol class="story-steps">
            {%- for it in b.items %}
            <li class="story-step"><span class="story-step-n">{{ loop.index }}</span><h3>{{ it.title }}</h3><p>{{ it.text }}</p></li>
            {%- endfor %}
        </ol>
        {%- if b.video %}
        <div class="story-video-embed">
            <iframe src="https://www.youtube-nocookie.com/embed/{{ b.video }}?rel=0" title="Quickler walkthrough" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        {%- endif %}
    </div>
</section>
{%- elif b.type == "cards" %}
<section class="story {{ altcls }} reveal-on-scroll">
    <div class="story-inner">
        {%- if b.eyebrow %}<p class="story-eyebrow">{{ b.eyebrow }}</p>{% endif %}
        <h2 class="story-h2">{{ b.heading | safe }}</h2>
        <div class="story-cards">
            {%- for it in b.items %}
            <a class="story-card" href="{{ it.href }}">{%- if it.kicker %}<span class="story-card-kicker">{{ it.kicker }}</span>{% endif %}<h3>{{ it.title }}</h3><p>{{ it.text }}</p></a>
            {%- endfor %}
        </div>
    </div>
</section>
{%- elif b.type == "tags" %}
<section class="story {{ altcls }} reveal-on-scroll">
    <div class="story-inner">
        {%- if b.eyebrow %}<p class="story-eyebrow">{{ b.eyebrow }}</p>{% endif %}
        <h2 class="story-h2">{{ b.heading | safe }}</h2>
        {%- if b.text %}<p class="story-text story-text-centre">{{ b.text | safe }}</p>{% endif %}
        <div class="story-tags">
            {%- for it in b.items %}
            <a href="{{ it.href }}" class="story-tag {{ 'story-tag-strong' if it.strong }}">{{ it.label }}</a>
            {%- endfor %}
        </div>
    </div>
</section>
{%- elif b.type == "video" %}
<section class="story story-video-panel {{ altcls }} reveal-on-scroll">
    <div class="story-inner">
        {%- if b.eyebrow %}<p class="story-eyebrow">{{ b.eyebrow }}</p>{% endif %}
        {%- if b.heading %}<h2 class="story-h2">{{ b.heading | safe }}</h2>{% endif %}
        <div class="story-video-embed">
            <iframe src="https://www.youtube-nocookie.com/embed/{{ b.video }}?rel=0" title="Quickler walkthrough" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </div>
</section>
{%- elif b.type == "raw" %}
<section class="story {{ altcls }} reveal-on-scroll"><div class="story-inner">{{ b.html | safe }}</div></section>
{%- endif %}
{%- endfor %}

{#- Trailing region: free-form page body (SEO prose etc.) + the footer.
    Lives INSIDE the scroll container but does NOT snap -- it scrolls
    normally after the full-screen panels. -#}
<div class="story-tail">
{{ content | safe }}
{% include "partials/footer.njk" %}
</div>

</main>
{%- for s in scripts %}
<script src="{{ s }}"></script>
{%- endfor %}
</body>
</html>
