{#- Head module. Per-page SEO comes from front-matter / data: seo.title, seo.description,
seo.keywords (opt), seo.author (default Philip Ross), seo.canonical, seo.ogType (default website),
seo.ogLocale (default en_GB), seo.twitterCard (default summary), seo.twitterTitle,
seo.twitterDescription, seo.hreflang [{lang,href}], seo.jsonld (raw string, opt). Favicon set + font
preload are identical on every page -> defined ONCE here. -#}
<head>
  <script src="/js/cookie-consent.js" defer></script>
  <script src="/js/nav-compact.js" defer></script>
  <script src="/js/reel-nav.js" defer></script>
  <script src="/js/persist-video.js" defer></script>

  <meta charset="UTF-8">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {%- if site.googleVerification %}
  <meta name="google-site-verification" content="{{ site.googleVerification }}">
  {%- endif %}
  <title>{{ seo.title }}</title>
  {%- if seo.hasMetaTitle != false %}
  <meta name="title" content="{{ seo.title }}">
  {%- endif %}
  <meta name="description" content="{{ seo.description }}">
  {%- if seo.keywords %}
  <meta name="keywords" content="{{ seo.keywords }}">
  {%- endif %}
  {%- if seo.hasAuthor != false %}
  <meta name="author" content="{{ seo.author or 'Philip Ross' }}">
  {%- endif %}
  <meta name="robots" content="{{ seo.robots or 'index, follow' }}">
  {%- if seo.hasOg != false %}

  <meta property="og:type" content="{{ seo.ogType or 'website' }}">
  <meta property="og:url" content="{{ seo.canonical }}">
  <meta property="og:title" content="{{ seo.ogTitle or seo.title }}">
  <meta property="og:description" content="{{ seo.ogDescription or seo.description }}">
  {#- og:image: per-page seo.ogImage if set, else the branded default card.
      Must be an ABSOLUTE URL (social scrapers reject relative paths) and a
      raster format (PNG/JPG -- SVG is not rendered by WhatsApp/LinkedIn/X).
      A relative seo.ogImage ("/assets/og/og-gas.jpg") is prefixed with the
      domain here so pages can stay path-relative. -#}
  {%- set ogImg = seo.ogImage or (site.domain + "/assets/og/default.png") %}
  {%- if ogImg and (ogImg | first) == "/" %}{% set ogImg = site.domain + ogImg %}{% endif %}
  <meta property="og:image" content="{{ ogImg }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ seo.ogImageAlt or 'Quickler — field compliance done on WhatsApp' }}">
  <meta name="twitter:image" content="{{ ogImg }}">
  <meta property="og:locale" content="{{ seo.ogLocale or 'en_GB' }}">
  {%- if seo.ogLocaleAlt %}
  <meta property="og:locale:alternate" content="{{ seo.ogLocaleAlt }}">
  {%- endif %}
  {%- endif %}
  {%- if seo.hasTwitter != false %}

  <meta name="twitter:card" content="{{ seo.twitterCard or 'summary_large_image' }}">
  <meta name="twitter:title" content="{{ seo.twitterTitle or seo.title }}">
  {%- if seo.hasTwitterDesc != false %}
  <meta name="twitter:description" content="{{ seo.twitterDescription or seo.description }}">
  {%- endif %}
  {%- endif %}

  <link rel="canonical" href="{{ seo.canonical }}">
  {%- for alt in seo.hreflang %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href }}">
  {%- endfor %}
  {%- if seo.jsonld %}

  <script type="application/ld+json">
{{ seo.jsonld | safe }}
  </script>
  {%- endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {#- Warm the YouTube hosts cheaply so the lite-video thumbnail loads fast and
      a later click-to-play connects quickly. dns-prefetch only -- no handshake
      cost on initial paint; the player JS still loads only on click. -#}
  <link rel="dns-prefetch" href="https://i.ytimg.com">
  <link rel="dns-prefetch" href="https://www.youtube-nocookie.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap">
  <link rel="stylesheet" href="/css/tokens.css?v={{ site.version }}">
  <link rel="stylesheet" href="/css/styles.v2.css?v={{ site.version }}">
  {%- if headStyle %}
  <style>{{ headStyle | safe }}</style>
  {%- endif %}
  {%- if headExtra %}
  {{ headExtra | safe }}
  {%- endif %}
</head>
