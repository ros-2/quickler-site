<footer>
  {%- if footerCta %}
  <div class="footer-cta-zone">
    <p class="footer-cta-heading">{{ footerCta.heading }}</p>
    <p class="footer-cta-sub">{{ footerCta.sub | safe }}</p>
    <div class="footer-cta-actions">
      {%- for a in footerCta.actions %}
      <a href="{{ a.href }}" class="{{ a.class }}">{{ a.label }}</a>
      {%- endfor %}
    </div>
  </div>
  <div class="footer-rule"></div>
  {%- endif %}
  <p>© {{ site.company }} 2026 · <a href="https://find-and-update.company-information.service.gov.uk/company/{{ site.companyNo }}" target="_blank" rel="noopener noreferrer">Company No. {{ site.companyNo }}</a> · ICO {{ site.ico }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  <p><a href="/pages/about.html">About</a> · <a href="/pages/services.html">Workflows</a> · <a href="/pages/pricing.html">Pricing</a> · <a href="/pages/guides.html">Guides</a> · <a href="/pages/workflows-regions.html">Regions</a> · <a href="/pages/help/index.html">Support</a> · <a href="/sitemap.xml">Sitemap</a></p>
  <p><a href="/pages/legal.html">Legal</a> · <a href="/pages/privacy.html">Privacy</a> · <a href="/pages/terms.html">Terms</a> · <a href="/pages/customer-terms.html">Customer terms</a> · <a href="/pages/dpa.html">DPA</a> · <a href="/pages/cookies.html">Cookies</a> · <a href="#" data-cookie-settings>Cookie settings</a></p>
  <div class="footer-social"><a class="footer-social-link" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer"><span>quickler on LinkedIn</span></a></div>
  <p style="text-align:center;font-size:0.78rem;opacity:0.7;margin-top:8px;"><a href="#top">Back to top ↑</a></p>
    <div class="site-version" style="text-align:center;font-size:0.75rem;opacity:0.55;margin-top:6px;">site version {{ site.version }}</div>
</footer>
