---
pagination:
  data: continentList
  size: 1
  alias: cont
layout: layouts/story.njk
permalink: "/pages/continent-{{ cont.slug }}.html"
bodyClass: page-story
eleventyComputed:
  hero:
    eyebrow: "Quickler worldwide"
    heading: "{{ cont.name }}."
    lede: "Quickler runs field compliance over WhatsApp across {{ cont.name }}. Pick a country to see its guides and resources."
    actions:
      - label: "All regions"
        href: "/pages/workflows-regions.html"
        style: "btn-secondary"
  seo:
    title: "Quickler in {{ cont.name }} | Field Compliance by Country"
    description: "Quickler field compliance resources across {{ cont.name }}. WhatsApp workflows, no app, structured digital records. Choose your country."
    canonical: "https://quickler.co/pages/continent-{{ cont.slug }}.html"
    lang: "en"
  scripts:
    - "/js/analytics-events.js"
---
{#- Country links rendered as a real .story snap panel (NOT a story-seo
    tail). Links in the tail get snapped away on touch and cannot be tapped;
    inside a proper panel they are reliably clickable. -#}
<section class="story story-feature">
  <div class="story-inner">
    <p class="story-eyebrow">Countries</p>
    <h2 class="story-h2">Countries in {{ cont.name }}.</h2>
    <div class="story-tags">
      {%- for c in countries %}
      {%- if c.continent == cont.name %}
      <a href="/pages/country-hub-{{ c.slug }}.html" class="story-tag">{{ c.name }}</a>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</section>
<section class="story story-cta">
  <div class="story-inner">
    <p class="story-eyebrow">Elsewhere</p>
    <h2 class="story-h2">Looking for a different market?</h2>
    <p class="story-text story-text-centre">Browse every region, or jump straight to the UK guides and templates.</p>
    <div class="story-actions">
      <a href="/pages/workflows-regions.html" class="btn btn-primary">All regions</a>
      <a href="/pages/guides.html" class="btn btn-secondary">UK guides</a>
    </div>
  </div>
</section>
