  "layout": "layouts/page.njk",
  "permalink": "/pages/help/index.html",
  "bodyClass": "page-inner",
  "seo": {
    "title": "Support | Quickler",
    "description": "Quickler support. Guides for signup, workflows, billing, privacy and troubleshooting, plus a contact form. Philip replies in person within one business day.",
    "canonical": "https://quickler.co/pages/help/index.html",
    "twitterTitle": "Quickler Support",
    "twitterDescription": "Guides for signup, workflows, billing, privacy and troubleshooting, plus a contact form.",
    "hasMetaTitle": true,
    "hreflang": [
      {
        "lang": "en-gb",
        "href": "https://quickler.co/pages/help/index.html"
      },
      {
        "lang": "x-default",
        "href": "https://quickler.co/pages/help/index.html"
      }
    ],
    "lang": "en",
    "jsonld": "{\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"TechArticle\",\n        \"headline\": \"Quickler help centre\",\n        \"description\": \"Quickler help centre. Guides for signup, workflows, engineers, team management, plans, privacy, troubleshooting and FAQs.\",\n        \"url\": \"https://quickler.co/pages/help/index.html\",\n        \"author\": {\"@type\": \"Person\", \"name\": \"Philip Ross\"},\n        \"publisher\": {\"@type\": \"Organization\", \"name\": \"Quickler Ltd\"}\n    }"
  },
  "footerCta": {
    "heading": "Still stuck?",
    "sub": "Email <a href=\"mailto:hello@quickler.co\" style=\"color:inherit;\">hello@quickler.co</a> — Philip replies in person within one business day.",
    "actions": [
      {
        "href": "#contact-form-section",
        "class": "btn btn-primary footer-cta-btn",
