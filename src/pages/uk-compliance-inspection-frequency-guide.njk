    "jsonld": "{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Article\",\n      \"headline\": \"UK Compliance & Inspection Frequency Guide 2026\",\n      \"description\": \"How often each recurring UK compliance check is typically required across care homes, schools, fleets, food businesses and general workplaces, with the regulator named. Many frequencies are risk-assessed, not fixed by law.\",\n      \"author\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Quickler Ltd\"\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Quickler Ltd\",\n        \"url\": \"https://quickler.co/\"\n      },\n      \"datePublished\": \"2026-08-27\",\n      \"dateModified\": \"2026-08-27\",\n      \"inLanguage\": \"en-GB\"\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How often must a care home test its fire alarm?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Weekly is standard practice. A different manual call point is tested each week so that, over time, every point is checked, following BS 5839. The Fire Safety Order 2005 requires the alarm system to be maintained in working order; the weekly test is the common way to meet that.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How often is a LOLER inspection required on a hoist?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"At least every 6 months. Under LOLER 1998, equipment used to lift people, such as a care-home hoist and its slings, must have a thorough examination by a competent person at least every six months. This is a fixed legal minimum, not a risk-assessed one.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How often must a school do a fire drill?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Termly is the common cadence, giving three drills a year, so that different times of day and staff patterns are covered. It is established school practice under the Fire Safety Order rather than a single stated legal number.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How often does a commercial vehicle need a walkaround check?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Every day, before the vehicle is first used. The DVSA expects a documented daily walkaround check of a goods vehicle or PSV, with any defects reported and recorded before the vehicle goes out.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Is PAT testing a legal requirement every year?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"No. Portable appliance testing has no fixed legal interval. The Electricity at Work Regulations 1989 require electrical equipment to be maintained to prevent danger; the frequency should be risk-assessed. Annual is common in higher-risk settings but is not a legal minimum.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Are these compliance frequencies legally fixed?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Mostly not. A few are fixed, such as the six-monthly LOLER hoist examination and the annual MOT. The majority are set by your own written risk assessment to meet a duty set by the regulator. Always confirm each item against the current guidance from the named body before setting a schedule.\"\n          }\n        }\n      ]\n    },\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"Home\",\n          \"item\": \"https://quickler.co/\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"UK Compliance & Inspection Frequency Guide\",\n          \"item\": \"https://quickler.co/pages/uk-compliance-inspection-frequency-guide.html\"\n        }\n      ]\n    }\n  ]\n}"
