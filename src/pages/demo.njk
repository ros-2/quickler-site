---json
{
  "layout": "layouts/page.njk",
  "permalink": "/pages/demo.html",
  "bodyClass": "page-inner",
  "seo": {
    "title": "Try quickler | Live WhatsApp Demo",
    "description": "Scan the QR code to try quickler on WhatsApp. Record a site observation by voice, text, or photo and see a professional report generated automatically.",
    "canonical": "https://quickler.co/pages/demo.html",
    "hasAuthor": false,
    "robots": "noindex, nofollow",
    "hasTwitterDesc": false,
    "hasTwitter": false,
    "hasOg": false,
    "hasMetaTitle": true,
    "lang": "en"
  },
  "headStyle": "\n        .demo-section {\n            min-height: calc(100vh - 120px);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            padding: 60px 24px;\n        }\n\n        .demo-inner {\n            max-width: 560px;\n            width: 100%;\n            text-align: center;\n        }\n\n        .demo-inner .eyebrow {\n            margin-bottom: 20px;\n        }\n\n        .demo-inner h1 {\n            font-size: clamp(1.9rem, 5vw, 2.8rem);\n            font-weight: 700;\n            line-height: 1.15;\n            letter-spacing: -0.02em;\n            color: var(--heading, #0d1a3a);\n            margin-bottom: 16px;\n        }\n\n        .demo-inner .demo-sub {\n            font-size: 1.05rem;\n            color: #556;\n            line-height: 1.6;\n            margin-bottom: 40px;\n        }\n\n        .qr-card {\n            display: inline-flex;\n            flex-direction: column;\n            align-items: center;\n            gap: 20px;\n            padding: 36px 40px 28px;\n            border: 1px solid var(--line);\n            border-radius: var(--radius-lg);\n            background: var(--surface-card-strong);\n            backdrop-filter: blur(18px) saturate(140%);\n            box-shadow: var(--shadow-card);\n            margin-bottom: 36px;\n            width: 100%;\n        }\n\n        #qr-canvas {\n            width: 220px;\n            height: 220px;\n        }\n\n        #qr-canvas canvas,\n        #qr-canvas img {\n            width: 220px !important;\n            height: 220px !important;\n            border-radius: 8px;\n        }\n\n        .qr-label {\n            font-size: 0.85rem;\n            font-weight: 600;\n            color: var(--accent);\n            letter-spacing: 0.04em;\n        }\n\n        .demo-start-note {\n            max-width: 28rem;\n            margin: -12px auto 26px;\n            padding: 12px 16px;\n            border: 1px solid rgba(24, 52, 132, 0.1);\n            border-radius: 18px;\n            background: rgba(255, 255, 255, 0.78);\n            color: var(--ink);\n            font-size: 0.95rem;\n            line-height: 1.55;\n            box-shadow: 0 10px 24px rgba(18, 41, 111, 0.05);\n        }\n\n        .demo-start-note strong {\n            color: var(--accent);\n        }\n\n        .demo-or {\n            display: flex;\n            align-items: center;\n            gap: 12px;\n            margin-bottom: 20px;\n            color: #aab;\n            font-size: 0.8rem;\n        }\n\n        .demo-or::before,\n        .demo-or::after {\n            content: \"\";\n            flex: 1;\n            height: 1px;\n            background: var(--line);\n        }\n\n        .demo-bullets {\n            list-style: none;\n            padding: 0;\n            margin: 0 0 40px;\n            text-align: left;\n            display: inline-block;\n        }\n\n        .demo-bullets li {\n            padding: 5px 0 5px 24px;\n            font-size: 0.93rem;\n            color: #445;\n            position: relative;\n            line-height: 1.5;\n        }\n\n        .demo-bullets li::before {\n            content: \"\";\n            position: absolute;\n            left: 0;\n            top: 11px;\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n            background: var(--brand-gradient);\n        }\n\n        .demo-back {\n            display: block;\n            margin-top: 28px;\n            font-size: 0.85rem;\n            color: #889;\n            text-decoration: none;\n        }\n\n        .demo-back:hover {\n            color: var(--accent);\n        }\n\n        @media (max-width: 480px) {\n            .qr-card {\n                padding: 28px 20px 22px;\n            }\n\n            #qr-canvas {\n                width: 180px;\n                height: 180px;\n            }\n\n            #qr-canvas canvas,\n            #qr-canvas img {\n                width: 180px !important;\n                height: 180px !important;\n            }\n        }\n    ",
  "scripts": [
    "https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js",
    "/js/analytics-events.js"
  ]
}
---
<main id="main-content">
        <section class="demo-section">
            <div class="demo-inner">
                <span class="eyebrow">Live demo</span>
                <h1>Try the live demo.</h1>
                <p class="demo-sub">Scan the code with your phone to open WhatsApp. Send a few messages by voice, text, or photo, and quickler turns them into a structured dashboard record.</p>

                <div class="qr-card">
                    <div id="qr-canvas"></div>
                    <span class="qr-label">Scan to open WhatsApp</span>
                </div>

                <p class="demo-start-note">After scanning the QR code or tapping WhatsApp, send <strong>hello</strong> to start the demo.</p>

                <div class="demo-or">or open on this device</div>

                <a id="wa-link" href="#" class="btn btn-primary" style="margin-bottom: 16px;">
                    Open in WhatsApp
                </a>

                <ul class="demo-bullets">
                    <li>Start by sending <strong>hello</strong> in WhatsApp</li>
                    <li>Takes about two minutes from start to dashboard record</li>
                    <li>Record by voice note, text, or photo — no typing required</li>
                    <li>Review and edit the draft before it is finalised</li>
                    <li>Your details are stored only to send you the report and follow up</li>
                </ul>

                <a href="/" class="demo-back">← Back to quickler.co</a>
            </div>
        </section>
    </main>
